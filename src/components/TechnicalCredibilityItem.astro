---
type Badge = {
  label: string;
  href?: string;
  image: string;
  alt: string;
};

interface Props {
  entry: {
    headline: string;
    href?: string;
    summary?: string;
    badges?: Badge[];
  };
}

const { entry } = Astro.props;
---

<div class="border-b border-border/70 pb-4 last:border-b-0 last:pb-0">
  {entry.href ? (
    <a href={entry.href} class="text-base font-semibold leading-6 text-primary underline decoration-primary/20 underline-offset-4 hover:text-secondary sm:text-lg">
      {entry.headline}
    </a>
  ) : (
    <p class="text-base font-semibold leading-6 text-primary sm:text-lg">{entry.headline}</p>
  )}
  {entry.summary && <p class="mt-1 text-sm leading-6 text-foreground/72">{entry.summary}</p>}
  {entry.badges && entry.badges.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {entry.badges.map((badge) => (
        badge.href ? (
          <a href={badge.href} class="transition hover:opacity-85" aria-label={badge.label}>
            <img src={badge.image} alt={badge.alt} class="h-5" loading="lazy" />
          </a>
        ) : (
          <img src={badge.image} alt={badge.alt} class="h-5" loading="lazy" />
        )
      ))}
    </div>
  )}
</div>
