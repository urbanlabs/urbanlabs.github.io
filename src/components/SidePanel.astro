---
interface Props {
  eyebrow?: string;
  title?: string;
  class?: string;
}

const { eyebrow, title, class: className } = Astro.props;
---

<aside class:list={["rounded-[1.4rem] border border-border/80 bg-white p-5 shadow-[var(--shadow-soft)]", className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <div class:list={[eyebrow ? "mt-4" : "", "space-y-4"]}>
    {title && <h3 class="text-base font-semibold text-foreground sm:text-lg">{title}</h3>}
    <div class="space-y-4">
      <slot />
    </div>
  </div>
</aside>
