---
interface Props {
  clients: {
    eyebrow: string;
    title: string;
    intro: string;
    organizations: {
      name: string;
      href?: string;
      related?: {
        label: string;
        href: string;
      }[];
    }[];
  };
}

const { clients } = Astro.props;

const blobClasses = [
  "sm:col-span-2 lg:col-span-3 rounded-[2rem] bg-[radial-gradient(circle_at_top_left,rgba(95,191,223,0.16),transparent_40%),#ffffff]",
  "rounded-[48%_52%_42%_58%/56%_38%_62%_44%] bg-[radial-gradient(circle_at_top_right,rgba(95,169,109,0.18),transparent_42%),#f8fcfa]",
  "rounded-[42%_58%_52%_48%/46%_58%_42%_54%] bg-[radial-gradient(circle_at_30%_20%,rgba(225,243,249,0.95),transparent_44%),#ffffff]",
  "sm:col-span-2 rounded-[2.4rem] bg-[radial-gradient(circle_at_75%_25%,rgba(95,191,223,0.15),transparent_42%),#fbfdfd]",
  "rounded-[56%_44%_45%_55%/44%_50%_50%_56%] bg-[radial-gradient(circle_at_70%_30%,rgba(95,169,109,0.16),transparent_40%),#f8fcfa]",
  "rounded-[2rem] bg-[radial-gradient(circle_at_18%_20%,rgba(225,243,249,0.9),transparent_38%),#ffffff]",
];
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(225,243,249,0.82),transparent_36%),linear-gradient(180deg,#f8fcfd_0%,#f7fbf8_100%)]"></div>
  <article class="section-shell relative py-12 sm:py-14">
    <div class="max-w-3xl">
      <p class="eyebrow">{clients.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-tight text-foreground sm:text-4xl">
        {clients.title}
      </h2>
      <p class="mt-4 max-w-3xl text-[1.04rem] leading-8 text-foreground/78 sm:text-[1.1rem]">
        {clients.intro}
      </p>
    </div>

    <ul class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {clients.organizations.map((organization, index) => (
        <li class:list={[
          "border border-border/70 px-5 py-5 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:shadow-[0_20px_40px_rgba(26,68,80,0.12)]",
          blobClasses[index % blobClasses.length],
        ]}>
          {organization.href ? (
            <a class="text-[1rem] font-semibold leading-6 text-primary underline decoration-primary/20 underline-offset-4" href={organization.href}>
              {organization.name}
            </a>
          ) : (
            <p class="text-[1rem] font-semibold leading-6 text-foreground">{organization.name}</p>
          )}

          {organization.related && organization.related.length > 0 && (
            <ul class="mt-4 space-y-2 text-[0.82rem] leading-5 text-foreground/68">
              {organization.related.map((item) => (
                <li>
                  <a class="inline-flex items-center gap-2 transition hover:text-primary" href={item.href}>
                    <span>{item.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </article>
</section>
