---
interface Props {
  eyebrow: string;
  profile: {
    name: string;
    role: string;
    photo: string;
    intro: string[];
    serviceApproach: string[];
    socialLinks: { label: string; href: string }[];
    skills: { category: string; description: string }[];
  };
}

const { eyebrow, profile } = Astro.props;
---

<section class="section-shell">
  <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div class="space-y-5">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{profile.name}</h2>
      <p class="text-lg leading-8 text-foreground/72">{profile.role}</p>
      <img
        src={profile.photo}
        alt={`Portrait of ${profile.name}`}
        class="w-56 rounded-[1.75rem] border border-border bg-white object-cover p-2 shadow-[var(--shadow-soft)]"
      />
      <div class="flex flex-wrap gap-3 text-sm">
        {profile.socialLinks.map((link) => (
          <a class="rounded-full border border-border bg-white px-4 py-2 transition hover:border-primary/25 hover:text-primary" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
    <div class="space-y-5">
      {profile.intro.map((paragraph) => (
        <p class="section-copy">{paragraph}</p>
      ))}
      {profile.serviceApproach.map((paragraph) => (
        <p class="section-copy">{paragraph}</p>
      ))}
      <div class="grid gap-5 md:grid-cols-2">
        {profile.skills.slice(0, 6).map((skill) => (
          <article class="grid-card">
            <h3 class="text-base font-semibold text-primary">{skill.category}</h3>
            <p class="mt-3 text-sm leading-7 text-foreground/72">{skill.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
