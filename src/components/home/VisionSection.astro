---
interface Props {
  section: {
    eyebrow: string;
    title: string;
    vision: {
      title: string;
      icon: string;
      description: string;
    }[];
  };
}

const { section } = Astro.props;

const focusIconModules = import.meta.glob("../../assets/focus-icons/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});

const getFocusIcon = (icon: string) =>
  focusIconModules[`../../assets/focus-icons/${icon}.svg`] as string | undefined;
---

<section id="vision" class="relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(210,236,247,0.86),transparent_40%),linear-gradient(180deg,#edf7fb_0%,#f9fcfd_28%,#f6fbfc_100%)]"></div>
  <div class="section-shell relative py-14 sm:py-16">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow">{section.eyebrow}</p>
      <h2 class="section-title mt-3 max-w-3xl">{section.title}</h2>
    </div>
    <div class="grid gap-x-10 gap-y-10 border-t border-border/70 pt-8 md:grid-cols-2 xl:grid-cols-3">
      {section.vision.map((item) => (
        <article class="border-b border-border/70 pb-8 xl:border-b-0">
          <div class="flex items-start gap-4">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent/70" aria-hidden="true">
              <img
                src={getFocusIcon(item.icon)}
                alt=""
                class="h-11 w-11"
                loading="lazy"
              />
            </div>
            <div class="pt-1">
              <h3 class="sr-only">{item.title}</h3>
              <p class="max-w-md text-base leading-8 text-foreground/76">{item.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
