---
interface Props {
  hero: {
    title: string;
    slogan: string;
    summary: string;
    jumpCta: {
      label: string;
      href: string;
    };
  };
}

const { hero } = Astro.props;
---

<section id="top" class="pb-0 pt-0">
  <div class="relative overflow-hidden bg-sky-deep shadow-[var(--shadow-hero)]">
    <img
      src="/img/hero-seattle.jpg"
      alt="Seattle skyline and park landscape"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-sky-deep/68 via-sky-deep/44 to-sky-dark/72"></div>
    <div class="absolute inset-x-0 bottom-0 h-[46%] bg-gradient-to-t from-meadow-dark/84 via-meadow-deep/26 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-b from-transparent via-meadow-deep/28 to-meadow-dark/58"></div>
    <div class="absolute -bottom-18 left-[10%] h-44 w-44 rounded-full bg-meadow-light/12 blur-3xl"></div>
    <div class="relative min-h-[100svh] px-5 py-5 sm:px-8 sm:py-7 lg:px-10 lg:py-8">
      <div class="mt-14 max-w-6xl sm:mt-18 lg:mt-20">
        <h1 class="hero-shadow-text max-w-4xl font-sans text-[3.4rem] font-extrabold tracking-[-0.05em] text-white sm:text-[4.8rem] lg:text-[6.25rem]">
          {hero.title}
        </h1>
        <p class="hero-shadow-text mt-2 font-serif text-[1.9rem] font-semibold leading-tight text-white/96 sm:mt-3 sm:text-[2.4rem] lg:text-[2.75rem]">
          {hero.slogan}
        </p>
        <p class="hero-shadow-text mt-8 max-w-[58rem] text-[1.08rem] leading-[1.42] font-medium text-white/96 sm:mt-9 sm:text-[1.35rem] lg:text-[1.65rem]">
          {hero.summary}
        </p>
        <div class="mt-8 flex flex-wrap gap-4 sm:mt-9">
          <a
            class="-ml-5 inline-flex items-center gap-5 rounded-r-[1.9rem] rounded-l-none bg-sky-deep/95 px-8 py-5 text-[1.35rem] font-semibold !text-white shadow-[var(--shadow-soft)] transition hover:bg-sky-dark sm:-ml-8 sm:px-10 sm:py-6 sm:text-[1.55rem] lg:-ml-10"
            href={hero.jumpCta.href}
          >
            <span>{hero.jumpCta.label}</span>
            <span aria-hidden="true" class="text-[2.1rem] leading-none sm:text-[2.4rem]">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
