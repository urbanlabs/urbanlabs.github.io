---
interface Props {
  section: {
    eyebrow: string;
    title: string;
    email: string;
    location: string;
  };
  content: any;
}

const { section, content: Content } = Astro.props;
---

<section class="section-shell pt-2">
  <div class="rounded-[1.8rem] bg-primary px-7 py-8 text-primary-foreground shadow-[var(--shadow-soft)] sm:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="eyebrow text-white/75">{section.eyebrow}</p>
        <h2 class="mt-3 font-sans text-3xl font-semibold sm:text-4xl">{section.title}</h2>
        <div class="mt-4 max-w-3xl text-base leading-8 text-white/85">
          <Content />
        </div>
      </div>
      <div class="flex flex-col gap-3 text-left lg:text-right">
        <a class="text-xl font-semibold text-white underline decoration-white/25 underline-offset-4" href={`mailto:${section.email}`}>
          {section.email}
        </a>
        <p class="text-sm text-white/78">{section.location}</p>
      </div>
    </div>
  </div>
</section>
