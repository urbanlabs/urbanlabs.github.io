---
import SidePanel from "../SidePanel.astro";
import TechnicalCredibilityItem from "../TechnicalCredibilityItem.astro";

interface Props {
  section: {
    eyebrow: string;
    title: string;
    featured: {
      headline: string;
      kind: string;
      href?: string;
      summary?: string;
      badges?: { label: string; href?: string; image: string; alt: string }[];
    }[];
  };
  content: any;
}

const { section, content: Content } = Astro.props;
---

<section class="section-shell">
  <div
    data-tech-cred-root
    class="relative lg:pr-[39rem]"
  >
    <div class="min-w-0 max-w-3xl space-y-4">
      <p class="eyebrow">{section.eyebrow}</p>
      <h2 class="section-title">{section.title}</h2>
      <div class="section-copy max-w-2xl space-y-4 [&_p]:mt-0 [&_h3]:mt-6 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-primary">
        <Content />
      </div>

      <div class="pt-3 lg:hidden">
        <button
          type="button"
          data-tech-cred-mobile-toggle
          aria-expanded="false"
          class="inline-flex items-center gap-3 rounded-full border border-primary/15 bg-white/88 px-5 py-3 text-sm font-semibold text-primary shadow-[var(--shadow-soft)] transition hover:border-primary/30 hover:bg-white"
        >
          <span>Selected experience</span>
          <span data-tech-cred-mobile-icon aria-hidden="true" class="text-lg leading-none transition">↓</span>
        </button>
        <div data-tech-cred-mobile-panel class="hidden pt-4">
          <SidePanel title="Selected experience">
            {section.featured.map((entry) => (
              <TechnicalCredibilityItem entry={entry} />
            ))}
          </SidePanel>
        </div>
      </div>
    </div>

    <div
      class="hidden lg:absolute lg:top-0 lg:right-[calc((100dvw-100%)/-2)] lg:block lg:h-full lg:max-w-[calc(100dvw-2rem)] lg:w-[36rem]"
    >
      <div
        data-tech-cred-desktop-shell
        class="flex h-full flex-col items-stretch"
      >
        <button
          type="button"
          data-tech-cred-desktop-toggle
          aria-expanded="false"
          class="ml-auto inline-flex w-[18rem] max-w-full items-center justify-between gap-3 rounded-l-[1.5rem] rounded-r-none border border-r-0 border-sky-dark/80 bg-sky-dark px-4 py-4 text-left text-sm font-semibold text-white shadow-[var(--shadow-soft)] transition hover:bg-sky-deep"
        >
          <span>Selected experience</span>
          <span data-tech-cred-desktop-icon aria-hidden="true" class="text-lg leading-none transition">↓</span>
        </button>
        <div
          data-tech-cred-desktop-panel
          class="mt-4 hidden min-h-0 flex-1 overflow-y-auto"
        >
          <SidePanel class="rounded-r-none border-r-0">
            {section.featured.map((entry) => (
              <TechnicalCredibilityItem entry={entry} />
            ))}
          </SidePanel>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const roots = document.querySelectorAll("[data-tech-cred-root]");

  roots.forEach((root) => {
    const mobileToggle = root.querySelector("[data-tech-cred-mobile-toggle]");
    const mobilePanel = root.querySelector("[data-tech-cred-mobile-panel]");
    const mobileIcon = root.querySelector("[data-tech-cred-mobile-icon]");

    if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
      mobileToggle.addEventListener("click", () => {
        const isOpen = mobileToggle.getAttribute("aria-expanded") === "true";
        mobileToggle.setAttribute("aria-expanded", String(!isOpen));
        mobilePanel.classList.toggle("hidden", isOpen);
        if (mobileIcon instanceof HTMLElement) {
          mobileIcon.textContent = isOpen ? "↓" : "↑";
        }
      });
    }

    const desktopToggle = root.querySelector("[data-tech-cred-desktop-toggle]");
    const desktopPanel = root.querySelector("[data-tech-cred-desktop-panel]");
    const desktopIcon = root.querySelector("[data-tech-cred-desktop-icon]");
    if (desktopToggle instanceof HTMLButtonElement && desktopPanel instanceof HTMLElement) {
      desktopToggle.addEventListener("click", () => {
        const isOpen = desktopToggle.getAttribute("aria-expanded") === "true";
        desktopToggle.setAttribute("aria-expanded", String(!isOpen));
        desktopPanel.classList.toggle("hidden", isOpen);
        if (desktopIcon instanceof HTMLElement) {
          desktopIcon.textContent = isOpen ? "↓" : "↑";
        }
      });
    }
  });
</script>
