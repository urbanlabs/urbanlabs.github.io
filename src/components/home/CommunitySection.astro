---
interface Props {
  section: {
    eyebrow: string;
    title: string;
    featured: {
      title: string;
      kind: string;
      href: string;
      summary: string;
    }[];
  };
  content: any;
}

const { section, content: Content } = Astro.props;
---

<article class="soft-panel p-7 sm:p-8">
  <p class="eyebrow">{section.eyebrow}</p>
  <h2 class="mt-3 text-2xl font-semibold text-foreground">{section.title}</h2>
  <div class="mt-3 space-y-4 [&_p]:text-base [&_p]:leading-8 [&_p]:text-foreground/75 [&_h3]:mt-6 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-primary">
    <Content />
  </div>
  <div class="mt-6 grid gap-4">
    {section.featured.map((entry) => (
      <div class="rounded-[1rem] border border-primary/12 bg-white/82 px-4 py-4">
        <p class="text-sm font-medium uppercase tracking-[0.16em] text-primary/70">{entry.kind}</p>
        <a class="mt-2 block text-lg font-semibold text-primary underline decoration-primary/25 underline-offset-4" href={entry.href}>
          {entry.title}
        </a>
        <p class="mt-2 text-sm leading-7 text-foreground/72">{entry.summary}</p>
      </div>
    ))}
  </div>
</article>
