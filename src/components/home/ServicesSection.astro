---
interface Props {
  section: {
    eyebrow: string;
    title: string;
    intro: string;
    tracks: {
      title: string;
      description: string;
      examples: {
        label: string;
        href: string;
      }[];
    }[];
  };
}

const { section } = Astro.props;
---

<section class="relative overflow-hidden bg-sky-dark text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(95,191,223,0.14),transparent_26%),radial-gradient(circle_at_78%_18%,rgba(117,186,129,0.14),transparent_24%),linear-gradient(180deg,rgba(25,61,71,0.98)_0%,rgba(29,69,80,0.96)_44%,rgba(23,56,65,1)_100%)]"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-white/12"></div>
  <div class="section-shell relative pt-8 pb-14 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-18">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:gap-12">
      <div class="max-w-2xl">
        <p class="eyebrow !text-sky-light/70">{section.eyebrow}</p>
        <h2 class="mt-3 font-sans text-4xl leading-tight font-semibold tracking-[-0.03em] text-white sm:text-5xl">
          {section.title}
        </h2>
      </div>
      <div class="border-t border-white/12 pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
        <p class="max-w-4xl text-[1.18rem] leading-9 font-medium text-white/90 sm:text-[1.28rem]">
          {section.intro}
        </p>
      </div>
    </div>
    <div class="mt-10 border-t border-white/12 pt-8 sm:mt-12 sm:pt-10">
      <div class="grid gap-x-10 gap-y-10 lg:grid-cols-2 xl:grid-cols-3">
        {section.tracks.map((track, index) => (
          <article class="flex flex-col">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-sky-light/55">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-[1.35rem] leading-tight font-semibold text-meadow-light">
              {track.title}
            </h3>
            <p class="mt-4 max-w-md text-[1.01rem] leading-8 text-white/76">
              {track.description}
            </p>
            <div class="mt-5">
              <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-sky-light/55">
                Selected examples
              </p>
              <ul class="mt-3 space-y-2 text-[0.88rem] leading-6 text-white/66">
                {track.examples.map((example) => (
                  <li>
                    <a
                      href={example.href}
                      class="inline-flex items-center gap-2 transition hover:text-white"
                    >
                      <span>{example.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
