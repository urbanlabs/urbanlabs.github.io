---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/photos/hero-seattle.jpg";

interface Props {
  hero: {
    slogan: string[];
    summary: string;
    detail: string;
    cta: { label: string; href: string };
  };
}
const { hero } = Astro.props;
const [first, second, last] = hero.slogan;
---

<section class="relative overflow-hidden bg-sky-deep text-white">
  <Image
    src={heroPhoto}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-[center_62%] opacity-40 mix-blend-luminosity"
  />
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(26,68,80,0.55)_0%,rgba(26,68,80,0.15)_45%,rgba(31,54,34,0.85)_100%)]"></div>
  <div class="relative mx-auto flex max-w-[1160px] flex-wrap items-end gap-x-14 gap-y-8 px-5 pt-16 sm:px-7 sm:pt-[72px]">
    <h1 class="m-0 min-w-0 flex-[1_1_560px] text-[clamp(72px,12vw,168px)] leading-[0.86] font-extrabold tracking-[-0.03em] text-white">
      {first}<br />{second}<br /><span class="text-meadow-pale">{last}</span>
    </h1>
    <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-5 pb-4">
      <p class="m-0 text-[clamp(26px,2.4vw,31px)] leading-tight text-white">{hero.summary}</p>
      <p class="m-0 font-sans text-[15px] text-sky-light">{hero.detail}</p>
      <a
        href={hero.cta.href}
        class="inline-flex min-h-[50px] items-center self-start rounded-full bg-paper px-6 font-sans text-base font-bold text-sky-dark no-underline hover:bg-white hover:text-sky-dark"
        >{hero.cta.label}</a
      >
    </div>
  </div>
  <div aria-hidden="true" class="relative mt-16 h-16">
    <div class="absolute inset-x-0 top-[26px] h-3 bg-meadow-medium"></div>
    <div class="relative mx-auto flex max-w-[1160px] justify-between px-5 sm:px-7">
      {[0, 1, 2, 3, 4].map(() => (
        <span class="mt-3 box-border h-10 w-10 rounded-full border-[6px] border-meadow-dark bg-paper"></span>
      ))}
    </div>
  </div>
</section>
