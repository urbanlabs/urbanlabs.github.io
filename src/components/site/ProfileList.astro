---
/* Index of project or experience profiles, as white cards in the homepage "How we help" style. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  intro: string;
  items: { href: string; title: string; meta: string; summary: string; image: ImageMetadata; imageAlt: string }[];
}
const { title, intro, items } = Astro.props;
---

<section class="page-width pt-14 pb-20" aria-labelledby="list-heading">
  <h1 id="list-heading" class="page-title">{title}</h1>
  <p class="lead mt-5">{intro}</p>

  <ul class="m-0 mt-12 grid list-none gap-8 p-0 md:grid-cols-2">
    {items.map((item) => (
      <li class="flex flex-col border border-[var(--card-border)] bg-white shadow-[var(--shadow-soft)]">
        <Image src={item.image} alt={item.imageAlt} widths={[540, 1080]} sizes="(min-width: 768px) 540px, 100vw" class="block h-48 w-full object-cover" />
        <div class="px-7 pt-5 pb-6">
          <h2 class="m-0 text-[27px] leading-tight font-bold">
            <a href={item.href} class="text-ink no-underline hover:text-sky-deep hover:underline">{item.title}</a>
          </h2>
          <p class="m-0 mt-2 font-sans text-sm font-semibold text-meadow-deep">{item.meta}</p>
          <p class="m-0 mt-3 text-ink-soft">{item.summary}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
