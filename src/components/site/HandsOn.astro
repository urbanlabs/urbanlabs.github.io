---
interface Props {
  section: {
    title: string;
    leadEmphasis: string;
    lead: string;
    items: { name: string; description: string; href?: string }[];
  };
}
const { section } = Astro.props;
---

<section id="hands" aria-labelledby="hands-heading" class="bg-meadow-dark text-white">
  <div class="mx-auto max-w-[1120px] px-5 py-[72px] sm:px-7">
    <div class="mb-9 flex flex-col gap-4">
      <h2 id="hands-heading" class="m-0 text-[clamp(40px,4.4vw,60px)] leading-none font-extrabold tracking-[-0.02em] text-white">{section.title}</h2>
      <p class="m-0 max-w-[920px] text-[clamp(26px,2.7vw,36px)] leading-[1.3] text-meadow-light">
        <strong class="highlight-dark font-bold text-white">{section.leadEmphasis}</strong>
        {section.lead}
      </p>
    </div>
    <ul class="m-0 list-none border-t-2 border-meadow-medium p-0">
      {section.items.map((item) => (
        <li class="grid gap-x-5 gap-y-1 border-b border-[rgba(227,241,229,0.22)] py-[18px] md:grid-cols-[1fr_2fr]">
          {item.href ? (
            <a href={item.href} class="text-[27px] leading-tight font-bold text-white decoration-meadow-medium decoration-2 hover:text-meadow-pale">{item.name}</a>
          ) : (
            <strong class="text-[27px] leading-tight">{item.name}</strong>
          )}
          <span class="text-meadow-light">{item.description}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
