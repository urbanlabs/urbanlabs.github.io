---
import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | UrbanLabs`} description={project.data.summary}>
  <main class="section-shell">
    <a href="/projects/" class="eyebrow hover:text-primary">Projects</a>

    <section class="mt-6 grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1 class="section-title">{project.data.title}</h1>
        <p class="mt-4 text-lg leading-8 text-foreground/78">{project.data.summary}</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="eyebrow">Role</p>
            <p class="mt-2 text-base leading-8 text-foreground/80">{project.data.role}</p>
          </div>
          <div>
            <p class="eyebrow">Clients</p>
            <ul class="mt-2 space-y-2 text-base leading-8 text-foreground/80">
              {project.data.clients.map((client) => <li>{client}</li>)}
            </ul>
          </div>
        </div>

        <div class="mt-8">
          <p class="eyebrow">Why It Matters</p>
          <p class="mt-2 text-base leading-8 text-foreground/80">{project.data.whyItMatters}</p>
        </div>

        <div class="mt-8">
          <p class="eyebrow">More</p>
          <div class="mt-3 flex flex-wrap gap-3">
            {project.data.links.map((link) => (
              <a
                href={link.href}
                class="rounded-full border border-border bg-white px-4 py-2 text-sm font-medium text-primary transition hover:border-primary/30"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <img
          src={project.data.image}
          alt={project.data.imageAlt}
          class="w-full rounded-[1.75rem] border border-border bg-white object-cover shadow-[var(--shadow-soft)]"
        />
        <div class="section-copy">
          <Content />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
