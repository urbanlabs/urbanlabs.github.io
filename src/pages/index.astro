---
import { getEntry } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import Hero from "../components/site/Hero.astro";
import NameSection from "../components/site/NameSection.astro";
import TransitMap from "../components/site/TransitMap.astro";
import HowWeHelp from "../components/site/HowWeHelp.astro";
import HandsOn from "../components/site/HandsOn.astro";
import Organizations from "../components/site/Organizations.astro";
import About from "../components/site/About.astro";
import Contact from "../components/site/Contact.astro";
import "../styles/global.css";

import * as HeroContent from "../content/home/hero.mdx";
import * as NameContent from "../content/home/background.mdx";
import * as VisionContent from "../content/home/vision.mdx";
import * as ServicesContent from "../content/home/services.mdx";
import * as CredibilityContent from "../content/home/credibility.mdx";
import * as AboutContent from "../content/home/about.mdx";
import * as ContactContent from "../content/home/contact.mdx";

const hero = HeroContent.frontmatter as any;
const clients = await getEntry("clients", "home");
if (!clients) throw new Error("Missing src/content/clients/home.yaml");
---

<BaseLayout title={hero.seo.title} description={hero.seo.description}>
  <SiteHeader />
  <main id="main" class="paper-notebook">
    <Hero hero={hero} />
    <div class="mx-auto max-w-[1120px] px-5 sm:px-7">
      <NameSection section={NameContent.frontmatter as any} content={NameContent.Content} />
    </div>
    <TransitMap section={VisionContent.frontmatter as any} />
    <div class="mx-auto max-w-[1120px] px-5 sm:px-7">
      <HowWeHelp section={ServicesContent.frontmatter as any} />
    </div>
    <HandsOn section={CredibilityContent.frontmatter as any} />
    <div class="mx-auto max-w-[1120px] px-5 sm:px-7">
      <Organizations clients={clients.data} />
      <About section={AboutContent.frontmatter as any} content={AboutContent.Content} />
    </div>
    <Contact section={ContactContent.frontmatter as any} content={ContactContent.Content} />
  </main>
</BaseLayout>
