---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";

type ExperienceFrontmatter = {
  title: string;
  summary: string;
  role: string;
  period: string;
  image: string;
  imageAlt: string;
};

const experienceModules = import.meta.glob("../../content/experiences/*.mdx", { eager: true });
const experiences = Object.entries(experienceModules)
  .map(([path, module]) => {
    const entry = module as { frontmatter: ExperienceFrontmatter };
    const slug = path.split("/").pop()?.replace(/\.mdx$/, "") ?? "";
    return { id: slug, data: entry.frontmatter };
  })
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Experience | UrbanLabs"
  description="Leadership, service, and field-building experience profiles from UrbanLabs."
>
  <main class="section-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">Experience</p>
      <h1 class="section-title mt-3">Selected experience profiles</h1>
      <p class="section-copy mt-4">
        These profiles highlight institution-building, community leadership, and field-shaping work that helps explain how UrbanLabs approaches public-interest technology.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {experiences.map((experience: { id: string; data: ExperienceFrontmatter }) => (
        <article class="soft-panel overflow-hidden">
          <img
            src={experience.data.image}
            alt={experience.data.imageAlt}
            class="h-48 w-full object-cover"
          />
          <div class="p-6">
            <h2 class="text-2xl font-semibold text-foreground">
              <a href={`/experience/${experience.id}/`} class="hover:text-primary">
                {experience.data.title}
              </a>
            </h2>
            <p class="mt-3 text-sm font-medium uppercase tracking-[0.16em] text-primary/75">
              {experience.data.role}
            </p>
            <p class="mt-2 text-sm leading-7 text-foreground/60">{experience.data.period}</p>
            <p class="mt-4 text-base leading-8 text-foreground/76">
              {experience.data.summary}
            </p>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
