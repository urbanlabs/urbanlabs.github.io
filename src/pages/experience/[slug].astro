---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";

type ExperienceFrontmatter = {
  title: string;
  summary: string;
  role: string;
  period: string;
  whyItMatters: string;
  organizations: string[];
  image: string;
  imageAlt: string;
  links: { label: string; href: string }[];
};
type ExperienceModule = {
  default: any;
  frontmatter: ExperienceFrontmatter;
};

export async function getStaticPaths() {
  const experienceModules = import.meta.glob("../../content/experiences/*.mdx", { eager: true });
  return Object.entries(experienceModules).map(([path, module]) => {
    const entry = module as ExperienceModule;
    const slug = path.split("/").pop()?.replace(/\.mdx$/, "") ?? "";
    return {
      params: { slug },
      props: {
        experience: {
          id: slug,
          Content: entry.default,
          data: entry.frontmatter,
        },
      },
    };
  });
}

const { experience } = Astro.props as {
  experience: {
    id: string;
    Content: any;
    data: ExperienceFrontmatter;
  };
};
const Content = experience.Content;
---

<BaseLayout title={`${experience.data.title} | UrbanLabs`} description={experience.data.summary}>
  <main class="section-shell">
    <a href="/experience/" class="eyebrow hover:text-primary">Experience</a>

    <section class="mt-6 grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1 class="section-title">{experience.data.title}</h1>
        <p class="mt-4 text-lg leading-8 text-foreground/78">{experience.data.summary}</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="eyebrow">Role</p>
            <p class="mt-2 text-base leading-8 text-foreground/80">{experience.data.role}</p>
          </div>
          <div>
            <p class="eyebrow">Period</p>
            <p class="mt-2 text-base leading-8 text-foreground/80">{experience.data.period}</p>
          </div>
        </div>

        <div class="mt-8">
          <p class="eyebrow">Organizations</p>
          <ul class="mt-2 space-y-2 text-base leading-8 text-foreground/80">
            {experience.data.organizations.map((organization: string) => <li>{organization}</li>)}
          </ul>
        </div>

        <div class="mt-8">
          <p class="eyebrow">Why It Matters</p>
          <p class="mt-2 text-base leading-8 text-foreground/80">{experience.data.whyItMatters}</p>
        </div>

        <div class="mt-8">
          <p class="eyebrow">More</p>
          <div class="mt-3 flex flex-wrap gap-3">
            {experience.data.links.map((link: { label: string; href: string }) => (
              <a
                href={link.href}
                class="rounded-full border border-border bg-white px-4 py-2 text-sm font-medium text-primary transition hover:border-primary/30"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <img
          src={experience.data.image}
          alt={experience.data.imageAlt}
          class="w-full rounded-[1.75rem] border border-border bg-white object-cover shadow-[var(--shadow-soft)]"
        />
        <div class="section-copy">
          <Content />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
